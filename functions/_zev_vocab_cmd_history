emulate -L zsh
# emulate does not reset a caller's no_multibyte; ${(L)w} on non-ASCII needs it.
setopt multibyte extended_glob
# _zev_vocab_cmd_history [N] -- "vocab history": the last N words shown
# (default 20), oldest first, as "YYYY-MM-DD HH:MM  word (pos): definition".
# Reads only the tail of the history file, so a large file stays fast.
local file data chunk l ts w x k n tab=$'\t' REPLY
local -a lines reply
local -A byw byl fmt
integer N=20 size start win c=0 loaded=0
if (( $# > 1 )) || [[ $# -eq 1 && $1 != <1-> ]]; then
  _zev_vocab_cmd_usage 'history takes one positive number'
  return
fi
if (( $# )); then
  # Leading zeros don't count ("0003" is 3); absurdly large N means "everything".
  n=${1##0#}
  if (( $#n > 9 )); then N=999999999; else N=$(( 10#$n )); fi
fi
_zev_vocab_state_dir
file=$REPLY/history
if [[ ! -f $file || ! -r $file ]]; then
  print -ru2 -- 'vocab: no history yet'
  return 0
fi
zmodload zsh/system 2>/dev/null
win=$(( N * 128 + 4096 ))
{
  {
    sysseek -w end 0
    size=$(( systell(0) ))
    while :; do
      start=$(( size > win ? size - win : 0 ))
      data=
      sysseek -w start $start
      while sysread -s 65536 chunk; do
        data+=$chunk
      done
      lines=( ${(f)data} )
      # The first line may be partial (even mid-UTF-8) unless we read from 0.
      (( start > 0 )) && shift lines
      # Lines without a tab are malformed; skip them.
      lines=( ${(M)lines:#*${tab}*} )
      (( $#lines >= N || start == 0 )) && break
      (( win *= 4 ))
    done
  } < $file
} 2>/dev/null
if (( ! $#lines )); then
  print -ru2 -- 'vocab: no history yet'
  return 0
fi
(( N > $#lines )) && N=$#lines
lines=( "${(@)lines[-N,-1]}" )
_zev_vocab_color && c=1
# The list is optional here: without it, history still shows the words.
_zev_vocab_words_file 2>/dev/null && _zev_vocab_load 2>/dev/null && loaded=1
if (( loaded )); then
  # Index the list once (exact word, and lowercased word -> line), so each
  # history line is an O(1) lookup. The first entry for a key wins, as in
  # _zev_vocab_lookup.
  for x in "$_zev_vocab_lines[@]"; do
    k=${x%%${tab}*}
    [[ -n $k ]] || continue
    (( ${+byw[$k]} )) || byw[$k]=$x
    k=${(L)k}
    (( ${+byl[$k]} )) || byl[$k]=$x
  done
fi
for l in "$lines[@]"; do
  ts=${l%%${tab}*}
  w=${l#*${tab}}
  ts="${ts[1,10]} ${ts[12,16]}"
  x=
  if (( loaded )) && [[ -n $w ]]; then
    if (( ${+byw[$w]} )); then
      x=$byw[$w]
    else
      k=${(L)w}
      (( ${+byl[$k]} )) && x=$byl[$k]
    fi
  fi
  if [[ -n $x ]]; then
    # Format each entry once: a function call per line is slow in a long loop.
    if (( ${+fmt[$x]} )); then
      REPLY=$fmt[$x]
    else
      reply=( "${(@ps:\t:)x}" )
      if (( c )); then
        _zev_vocab_format -c "$reply[1]" "$reply[2]" "$reply[3]" ''
      else
        _zev_vocab_format "$reply[1]" "$reply[2]" "$reply[3]" ''
      fi
      fmt[$x]=$REPLY
    fi
  elif (( c )); then
    REPLY=$'\e[1m'$w$'\e[0m'
    (( loaded )) && REPLY+=' (not in the word list)'
  else
    REPLY=$w
    (( loaded )) && REPLY+=' (not in the word list)'
  fi
  if (( c )); then
    _zev_vocab_wrap $'\e[2m'"$ts"$'\e[0m  '"$REPLY"
    print -r -- "$REPLY"
  else
    _zev_vocab_wrap "$ts  $REPLY"
    print -r -- "$REPLY"
  fi
done
return 0
