#compdef vocab
emulate -L zsh
# Completion for the vocab command: subcommands, words from the list (search,
# fav) and favorites (unfav).
setopt extended_glob multibyte
local curcontext=$curcontext state state_descr line expl ret=1 REPLY
local -a reply _zev_vocab_lines _zev_c
typeset -A opt_args
_arguments -C '1: :->command' '*:: :->arg' && return 0
case $state in
  command)
    _zev_c=(
      'next:show a new word'
      'search:search words (-d: definitions too)'
      'fav:favorite the current word or a named one'
      'unfav:remove a favorite'
      'favs:list favorites'
      'history:list recently shown words'
      'help:show usage'
    )
    _describe -t commands 'vocab command' _zev_c && ret=0
    ;;
  arg)
    curcontext=${curcontext%:*:*}:vocab-$words[1]:
    case $words[1] in
      search)  _arguments -C '-d[also match definitions]' '*: :->word' && ret=0 ;;
      fav)     _arguments -C '*: :->word' && ret=0 ;;
      unfav)   _arguments -C '*: :->favorite' && ret=0 ;;
      history) _arguments '1:number of entries (default 20): ' && ret=0 ;;
    esac
    case $state in
      word)
        # Copy reply first: completion internals overwrite it.
        _zev_vocab_words 2>/dev/null && _zev_c=( "${reply[@]}" ) &&
          _wanted vocab-words expl word compadd -a _zev_c && ret=0
        ;;
      favorite)
        _zev_vocab_cmd_favread 2>/dev/null && (( $#reply )) && _zev_c=( "${reply[@]}" ) &&
          _wanted vocab-favorites expl favorite compadd -a _zev_c && ret=0
        ;;
    esac
    ;;
esac
return ret
