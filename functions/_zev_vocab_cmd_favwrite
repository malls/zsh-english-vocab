emulate -L zsh
# _zev_vocab_cmd_favwrite PATH WORD... -- atomically replace the favorites file
# PATH with WORD... (one per line). A symlink is kept: the file it points to is
# rewritten. The caller holds the lock. rc 1 on failure.
local target=$1 tmp
local -a l
integer rc hops=0
shift
[[ -n $target ]] || return 1
if [[ -L $target && -e $target ]]; then
  target=${target:A}
else
  # :A leaves a dangling link (its file not created yet) unresolved; follow it
  # by hand so the file is created where the link points.
  while [[ -L $target ]] && (( hops++ < 16 )); do
    zmodload -F zsh/stat b:zstat 2>/dev/null || return 1
    zstat -A l +link -- $target 2>/dev/null || return 1
    [[ -n $l[1] ]] || return 1
    if [[ $l[1] == /* ]]; then
      target=$l[1]
    else
      target=${target:h}/$l[1]
    fi
  done
  [[ -L $target ]] && return 1
fi
tmp=$target.tmp.$$
zmodload -F zsh/files b:zf_mv b:zf_rm 2>/dev/null
if (( $# )); then
  { print -rl -- "$@" >| $tmp } 2>/dev/null
  rc=$?
else
  { : >| $tmp } 2>/dev/null
  rc=$?
fi
(( rc == 0 )) && zf_mv -f $tmp $target 2>/dev/null && return 0
zf_rm -f $tmp 2>/dev/null
return 1
